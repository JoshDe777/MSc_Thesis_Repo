MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6833227051032127546}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The goal here is mostly to\njust play and enjoy yourself.\nThere will
    be no outside \nrewards for how your \nmatches will go, or how \nmany you play.\n\nWhen
    you are done, open \nthe main menu on your left controller's options button,
    then press \"Close Experiment\" to exit the app.\n\nIf you feel unwell at any
    point in time, please immediately remove the headset and take a break. \nWater
    will be made available to you, and I can point you to the restrooms if needed."
