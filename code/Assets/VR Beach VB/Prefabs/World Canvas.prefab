  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Hitting the ball is fairly \nstraightforward. You swing \nwith your dominant
    hand as\nyou would in real life.\n\nFor 1-handed hits, the only\nfactor determining
    direction \nis the direction of the swing!\n\nI unfortunately did not have the
    time to add considerations for e.g. palm orientation or other more complex factors.
    So swing in the direction you want the ball to go, no matter the direction your
    hand points to.\nSwing speed determines the strength of the hit."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
